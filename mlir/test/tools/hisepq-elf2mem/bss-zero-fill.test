# REQUIRES: hisepq
# RUN: yaml2obj %s -o %t.elf
# RUN: hisepq-elf2mem %t.elf | FileCheck %s

# .bss is SHT_NOBITS: the segment below covers it with p_memsz (0xc) but not with
# p_filesz (0x4). Its two words have to show up as zeros in the memory image,
# because nothing zeroes .bss at run time.

# FIXME: decide if this test stays

# CHECK:      @00000020
# CHECK-NEXT: DDCCBBAA
# CHECK-NEXT: 00000000
# CHECK-NEXT: 00000000

--- !ELF
FileHeader:
  Class:   ELFCLASS32
  Data:    ELFDATA2LSB
  Type:    ET_EXEC
  Machine: EM_RISCV
Sections:
  - Name:         .text
    Type:         SHT_PROGBITS
    Flags:        [ SHF_ALLOC, SHF_EXECINSTR ]
    Address:      0x80
    AddressAlign: 0x4
    Content:      'AABBCCDD'
  - Name:         .bss
    Type:         SHT_NOBITS
    Flags:        [ SHF_ALLOC, SHF_WRITE ]
    Address:      0x84
    AddressAlign: 0x4
    Size:         0x8
ProgramHeaders:
  - Type:     PT_LOAD
    Flags:    [ PF_R, PF_W, PF_X ]
    VAddr:    0x80
    FirstSec: .text
    LastSec:  .bss
